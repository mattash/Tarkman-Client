{
  "name": "tarkman",
  "version": "1.6.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run web --prefix apps/mobile --",
    "build": "npm run export:web --prefix apps/mobile --",
    "test": "npm run test --prefix apps/mobile --",
    "typecheck": "npm run typecheck --prefix apps/mobile --",
    "lint": "npm run lint --prefix apps/mobile --",
    "mobile": "npm run start --prefix apps/mobile --",
    "mobile:ios": "npm run ios --prefix apps/mobile --",
    "mobile:android": "npm run android --prefix apps/mobile --",
    "mobile:web": "npm run web --prefix apps/mobile --",
    "mobile:export": "npm run export:web --prefix apps/mobile --",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile",
    "mobile:config": "npm run config --prefix apps/mobile",
    "tv": "npm run start --prefix apps/tv --",
    "tv:tvos": "npm run tvos --prefix apps/tv --",
    "tv:typecheck": "npm run typecheck --prefix apps/tv",
    "tv:export": "npm run export:tvos --prefix apps/tv --",
    "tv:check": "npm run check:runtime --prefix apps/tv && npm run check:identity --prefix apps/tv",
    "core:build": "node apps/mobile/node_modules/typescript/bin/tsc -p packages/tarkman-core/tsconfig.json",
    "core:test": "npm run core:build && node --test packages/tarkman-core/tests/*.test.mjs && npm run core:check",
    "core:check": "node packages/tarkman-core/scripts/check-boundary.mjs",
    "core:check-consumers": "node packages/tarkman-core/scripts/check-consumers.mjs",
    "lectionary:test": "npm test --prefix packages/tarkman-lectionary",
    "reader:check": "node packages/tarkman-reader/scripts/check-boundary.mjs",
    "metro:test": "node --test tools/metro/*.test.mjs",
    "design:check": "npm run check --prefix packages/tarkman-design",
    "legacy-web:dev": "npm run dev --prefix apps/web --",
    "legacy-web:build": "npm run build --prefix apps/web --",
    "legacy-web:test": "npm run test --prefix apps/web --",
    "legacy-web:typecheck": "npm run typecheck --prefix apps/web --"
  }
}
