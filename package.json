{
  "name": "tarkman",
  "version": "1.6.1",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix apps/web --",
    "build": "npm run build --prefix apps/web --",
    "preview": "npm run preview --prefix apps/web --",
    "test": "npm run test --prefix apps/web --",
    "test:coverage": "npm run test:coverage --prefix apps/web --",
    "test:integration": "npm run test:integration --prefix apps/web --",
    "typecheck": "npm run typecheck --prefix apps/web --",
    "mobile": "npm run start --prefix apps/mobile --",
    "mobile:ios": "npm run ios --prefix apps/mobile --",
    "mobile:android": "npm run android --prefix apps/mobile --",
    "mobile:web": "npm run web --prefix apps/mobile --",
    "mobile:export": "npm run export:web --prefix apps/mobile --",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile",
    "mobile:config": "npm run config --prefix apps/mobile",
    "core:build": "node apps/web/node_modules/typescript/bin/tsc -p packages/tarkman-core/tsconfig.json",
    "core:test": "npm run core:build && node --test packages/tarkman-core/tests/*.test.mjs && npm run core:check",
    "core:check": "node packages/tarkman-core/scripts/check-boundary.mjs",
    "core:check-consumers": "node packages/tarkman-core/scripts/check-consumers.mjs"
  }
}
