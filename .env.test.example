# Environment variables for testing

# API Configuration
VITE_API_URL=https://tarkman.onrender.com
VITE_DEFAULT_CHURCH_ID=1

# Pusher Configuration
VITE_PUSHER_APP_KEY=your_pusher_app_key
VITE_PUSHER_CLUSTER=eu

# Integration Test Credentials (optional - only needed for integration tests)
# If not provided, integration tests will be skipped
VITE_TEST_EMAIL=your_test_email@example.com
VITE_TEST_PASSWORD=your_test_password

# Integration Test Data (optional - defaults to session 10)
VITE_TEST_SESSION_ID=10
