# Environment variables for integration testing

# API Configuration
VITE_API_URL=https://www.tarkman.app
VITE_DEFAULT_CHURCH_ID=1
VITE_ACTIONCABLE_URL=https://www.tarkman.app/cable

# Optional authenticated integration-test credentials.
# Keep real values in a local ignored `.env.test` file.
VITE_TEST_EMAIL=your-test-user@example.com
VITE_TEST_PASSWORD=your-test-password

# Optional integration-test data
VITE_TEST_SESSION_ID=10
