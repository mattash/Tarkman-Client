{
  "name": "@tarkman/tv",
  "version": "0.2.6",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "tvos": "EXPO_TV=1 expo run:ios",
    "prebuild:tvos": "EXPO_TV=1 expo prebuild --platform ios --clean",
    "export:tvos": "EXPO_TV=1 expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "config": "EXPO_TV=1 expo config --type public",
    "check:identity": "node scripts/check-identity.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test": "jest --runInBand",
    "lint": "eslint . --max-warnings 0",
    "check:fonts": "node scripts/check-fonts.mjs"
  },
  "dependencies": {
    "@tarkman/core": "file:../../packages/tarkman-core",
    "@tarkman/design": "file:../../packages/tarkman-design",
    "@tarkman/reader": "file:../../packages/tarkman-reader",
    "expo": "~58.0.25",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-keep-awake": "~58.0.4",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.88.1-0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native-tvos/config-tv": "0.1.6",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "@types/node": "^24.0.0",
    "test-renderer": "1.3.0"
  },
  "overrides": {
    "react-native": "$react-native",
    "test-renderer": "1.3.0"
  }
}
