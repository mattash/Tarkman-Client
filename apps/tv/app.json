{
  "expo": {
    "name": "Tarkman",
    "slug": "tarkman-tv",
    "owner": "mesropash",
    "version": "0.2.5",
    "platforms": [
      "ios"
    ],
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.tarkman",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true
        }
      ],
      "./plugins/withSceneLifecycle",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SourceSerif4-Regular.ttf",
            "./assets/fonts/SourceSerif4-Semibold.ttf",
            "./assets/fonts/NotoSerifArmenian-Regular.ttf",
            "./assets/fonts/NotoSerifArmenian-Bold.ttf"
          ]
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "970aa9d7-0c63-448e-aa5d-189625964c5a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/970aa9d7-0c63-448e-aa5d-189625964c5a"
    }
  }
}
