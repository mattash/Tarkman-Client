{
  "expo": {
    "name": "Tarkman",
    "slug": "tarkman-tv",
    "owner": "mesropash",
    "version": "0.2.6",
    "platforms": [
      "ios"
    ],
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.tarkman",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "appleTVImages": {
            "icon": "./assets/icons/tvos-icon-1280x768.png",
            "iconSmall": "./assets/icons/tvos-icon-small-400x240.png",
            "iconSmall2x": "./assets/icons/tvos-icon-small-800x480.png",
            "topShelf": "./assets/icons/topshelf-1920x720.png",
            "topShelf2x": "./assets/icons/topshelf-3840x1440.png",
            "topShelfWide": "./assets/icons/topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/icons/topshelf-wide-4640x1440.png"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SourceSerif4-Regular.ttf",
            "./assets/fonts/SourceSerif4-Semibold.ttf",
            "./assets/fonts/NotoSerifArmenian-Regular.ttf",
            "./assets/fonts/NotoSerifArmenian-Bold.ttf"
          ]
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "970aa9d7-0c63-448e-aa5d-189625964c5a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/970aa9d7-0c63-448e-aa5d-189625964c5a"
    }
  }
}
