{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_TV": "1"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "development-simulator": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "channel": "tv-development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "tv-preview",
      "environment": "preview"
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "tv-production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "FHF872BAQR",
        "ascAppId": "6810790124"
      }
    }
  }
}
