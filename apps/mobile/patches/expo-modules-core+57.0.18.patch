+// Fabric retains dynamically allocated view classes across React runtime reloads. Their initializer
+// must retain a holder that can move to the new AppContext without replacing an IMP still in use.
+private final class ExpoFabricAppContextHolder {
+  private let lock = NSLock()
+  private var context: AppContext
+
+  init(_ context: AppContext) {
+    self.context = context
+  }
+
+  func update(_ context: AppContext) {
+    lock.lock()
+    self.context = context
+    lock.unlock()
+  }
+
+  func current() -> AppContext {
+    lock.lock()
+    defer { lock.unlock() }
+    return context
+  }
+}
