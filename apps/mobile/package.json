    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "^19.2.3",
