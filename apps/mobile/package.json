{
  "name": "@tarkman/mobile",
  "version": "0.2.7",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "config": "expo config --type public",
    "test": "jest --runInBand",
    "maestro:android": "node scripts/maestro-android.mjs",
    "test:maestro-android": "node --test scripts/maestro-android.test.mjs",
    "test:native-inputs": "node --test scripts/native-inputs.test.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:fonts": "node scripts/check-fonts.mjs",
    "check:store-config": "node scripts/check-store-config.mjs"
  },
  "expo": {
    "install": {
      "exclude": ["@sentry/react-native"]
    }
  },
  "dependencies": {
    "@react-native-vector-icons/ionicons": "13.1.4",
    "@sentry/react-native": "~8.35.0",
    "@shopify/flash-list": "2.3.2",
    "@tarkman/core": "file:../../packages/tarkman-core",
    "@tarkman/design": "file:../../packages/tarkman-design",
    "@tarkman/lectionary": "file:../../packages/tarkman-lectionary",
    "@tarkman/reader": "file:../../packages/tarkman-reader",
    "expo": "~58.0.25",
    "expo-app-intents": "~0.5.17",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "nativewind": "^4.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.19",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
