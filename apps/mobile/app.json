{
  "expo": {
    "name": "Tarkman",
    "slug": "tarkman",
    "owner": "mesropash",
    "version": "0.1.0",
    "scheme": "tarkman",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "app.tarkman",
      "associatedDomains": [
        "applinks:web.tarkman.app"
      ]
    },
    "android": {
      "package": "app.tarkman"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sqlite",
      [
        "@sentry/react-native/expo",
        {
          "organization": "st-john-armenian-church",
          "project": "tarkman-mobile",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c76aa8c8-fb02-40b5-b4ae-8469b1bbeb47"
      }
    },
    "userInterfaceStyle": "automatic"
  }
}
