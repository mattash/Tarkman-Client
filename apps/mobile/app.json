{
  "expo": {
    "name": "Tarkman",
    "slug": "tarkman",
    "owner": "mesropash",
    "version": "0.2.5",
    "scheme": "tarkman",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "app.tarkman",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:web.tarkman.app"
      ],
      "icon": "./assets/icons/app-icon.png",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "0A2A.1",
              "3B52.1",
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "app.tarkman",
      "icon": "./assets/icons/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "backgroundColor": "#6E3852"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "web.tarkman.app",
              "pathPattern": "/sessions/.*/parts"
            },
            {
              "scheme": "https",
              "host": "web.tarkman.app",
              "pathPattern": "/sessions/.*/parts/"
            },
            {
              "scheme": "https",
              "host": "web.tarkman.app",
              "pathPattern": "/sessions/.*/part/.*"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Tarkman uses the camera only to scan a service's QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sqlite",
      [
        "@sentry/react-native/expo",
        {
          "organization": "st-john-armenian-church",
          "project": "tarkman-mobile",
          "url": "https://sentry.io/"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationWhenInUsePermission": "Tarkman checks your location on this device to offer the service at the church you are in. Your location is never sent anywhere.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c76aa8c8-fb02-40b5-b4ae-8469b1bbeb47"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c76aa8c8-fb02-40b5-b4ae-8469b1bbeb47"
    },
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icons/app-icon.png"
  }
}
