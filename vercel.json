{
  "buildCommand": "CI=1 npm run mobile:export",
  "devCommand": "npm run web --prefix apps/mobile",
  "installCommand": "npm ci --prefix apps/mobile",
  "outputDirectory": "apps/mobile/dist",
  "redirects": [
    {
      "source": "/sessions/:id(\\d+)/explanations",
      "destination": "/sessions/:id/parts",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/sign-in",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/part/:id",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
