{
  "buildCommand": "CI=1 npm run mobile:export",
  "devCommand": "npm run web --prefix apps/mobile",
  "installCommand": "npm ci --prefix apps/mobile",
  "outputDirectory": "apps/mobile/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
