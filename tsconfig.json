{
    "compilerOptions": {
      "jsx": "react-jsx",
      "moduleResolution": "node",
      "module": "ESNext",
      "target": "ES2022",
      "skipLibCheck": true,
      "strictNullChecks": true,
      "esModuleInterop": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["./app/*"]
      },
      "types": ["vite/client", "node", "@testing-library/jest-dom", "vitest/globals"]
    },
    "include": ["app/**/*", "env.d.ts"],
    "exclude": ["node_modules"]
  }